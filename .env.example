# Copia in .env (non versionato) e compila. Le variabili gia' nell'ambiente
# hanno la precedenza. In Docker: docker run --env-file .env ...

# Chiave di firma di Django. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Se omessa, ne viene generata una a caso in HDN_STATE_DIR/secret_key.
HDN_SECRET_KEY=

# Azure OpenAI / Foundry (in alternativa all'inserimento dalla pagina Settings)
HDN_AZURE_ENDPOINT=
HDN_AZURE_DEPLOYMENT=
HDN_AZURE_API_VERSION=
HDN_AZURE_API_KEY=
