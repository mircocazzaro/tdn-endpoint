# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------------------------------------------------------------------------
# Dati locali dell'istituzione.
#
# Il repository contiene il codice dell'endpoint e il template di mapping.
# Dati dei pazienti, database popolati e mapping istanziati sono artefatti
# locali di ciascun nodo e non vanno versionati: un HDN Endpoint e' per
# definizione il custode dei propri dati.
# ---------------------------------------------------------------------------
*.duckdb
*.duckdb.wal
*.sqlite3
local-testdata/

# Il mapping attivo e' configurazione per singolo sito, derivata dal template
# su uno schema locale: non e' sorgente condivisa.
myapp/obda/hereditary_ontology_2.obda
myapp/obda/*_old.obda

# Stato di runtime, log e audit (compresi i file ruotati, es. ontop.log.1)
*.log
*.log.[0-9]*
nohup.out
myapp/obda/ontop.pid
audit.log

# Artefatti di collectstatic
/staticfiles/

# Ambiente
.env

# ---------------------------------------------------------------------------
# uploads/ ospita i CSV caricati dall'amministratore locale, che sono dati.
# Il catalogo delle query ammesse e' codice (myapp/catalog.py) e non passa piu'
# da qui. Resta versionato solo level.duckdb, la policy di disclosure del
# singolo sito, che dovrebbe diventare configurazione locale con default L0.
# ---------------------------------------------------------------------------
uploads/*
!uploads/level.duckdb
